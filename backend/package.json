{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed:range": "node scripts/seed-realistic-date-range.mjs",
    "db:init": "node scripts/ensure-local-env.mjs && node scripts/init-sqlite.mjs"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "@fastify/multipart": "~10.1.1",
    "@fastify/static": "~10.1.3",
    "dotenv": "latest",
    "fastify": "latest",
    "mysql2": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "5.7.3"
  }
}
